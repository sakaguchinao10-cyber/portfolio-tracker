# ====================================================
# 日本株 朝のアラート 設定ファイル
# このファイルを .env としてコピーして値を設定してください
# cp .env.example .env
# ====================================================

# --- スケジュール設定 ---
# 毎朝アラートを送信する時刻 (HH:MM形式、JST)
ALERT_TIME=07:00

# --- メール通知設定 (任意) ---
# Gmailの場合: smtp.gmail.com / ポート: 587
# ※Gmailはアプリパスワードが必要 (2段階認証設定後に取得)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL=destination@example.com

# --- LINE Notify設定 (任意) ---
# https://notify-bot.line.me/ja/ でトークンを取得
LINE_NOTIFY_TOKEN=

# --- 分析設定 ---
# 相関計算に使う過去日数 (デフォルト: 90日)
LOOKBACK_DAYS=90

# APIサーバーのポート (デフォルト: 8000)
API_PORT=8000

# --- リモートアクセス設定 (ngrok / 任意) ---
# https://dashboard.ngrok.com/get-started/your-authtoken でトークンを取得
# 未設定でも動作するが、設定するとセッション制限が緩和される
NGROK_AUTHTOKEN=
